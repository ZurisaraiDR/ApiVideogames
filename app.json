{
  "expo": {
    "scheme": "your-app-scheme",
    "name": "GameSpace",
    "slug": "my-expo-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/iconApp.png",
          "backgroundColor": "#0D0D0D",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      "expo-router"
    ],
    "orientation": "portrait",
    "icon": "./assets/iconApp.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconApp.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.anonymous.myexpoapp"
    }
  }
}
